{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Build output is not listed here, and excluding it below is hygiene rather than a fix.
  //
  // What makes `pnpm typecheck` disagree with CI is neither of those. `next-env.d.ts` is
  // generated, gitignored, and imports `.next/dev/types/routes.d.ts`, which declares LayoutProps
  // and PageProps as globals. An explicit import pulls a file into the program regardless of
  // include or exclude, so no setting in this file can close that gap: locally the file exists,
  // in a fresh checkout it was never generated.
  //
  // The check that does close it is tests/generated-types.test.ts. Read the note there - it cost
  // twelve red CI runs and twelve skipped deploys to find, and two wrong fixes on the way.
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts"],
  // Keeps tsc from walking a 25 MB server bundle, since the globs above reach into it. This does
  // not affect which globals resolve - see above.
  "exclude": ["node_modules", ".next", ".open-next"]
}
