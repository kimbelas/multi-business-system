# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext build output
.open-next/

# Local environment
.env.local
.env*.local

# Playwright
test-results/
playwright-report/

# Browser sessions and the fixture manifest the e2e suite writes. Real cookies for real accounts,
# and the manifest carries their generated passwords - per-run, deleted by the teardown, and never
# committed.
tests-e2e/.auth
