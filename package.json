    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e:deployed": "playwright test deployed.spec.ts",
    "palette": "node --experimental-strip-types scripts/palette-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
